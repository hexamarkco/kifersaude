# Preencha estes valores com a URL e chaves do seu projeto Supabase.
# Exemplos:
# - Projeto hospedado: https://<project>.supabase.co
# - Supabase CLI (local): http://127.0.0.1:54321

VITE_SUPABASE_URL=https://<project>.supabase.co
# Opcionalmente, utilize o endpoint local da CLI: http://127.0.0.1:54321/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=https://<project>.supabase.co/functions/v1
VITE_SUPABASE_ANON_KEY=seu-anon-key

# SEO público. Em produção, configure a URL canônica; em preview/staging,
# defina VITE_SITE_INDEXABLE=false para reforçar a proteção contra indexação.
VITE_SITE_URL=https://www.kifersaude.com.br
VITE_SITE_INDEXABLE=true
# Preencha somente com tokens reais de verificação.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# IMPORTANTE:
# Nunca exponha a service role key com prefixo VITE_.
# SUPABASE_SERVICE_ROLE_KEY e TENOR_API_KEY são secrets exclusivos do servidor.
# Configure Edge Functions pelo gerenciador de secrets do Supabase; não os copie
# para .env.local do frontend nem para variáveis com prefixo VITE_.
