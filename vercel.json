{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kifersaude.com.br" }],
      "destination": "https://www.kifersaude.com.br/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/links", "destination": "/index.html" },
    { "source": "/forms/:slug", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/chat", "destination": "/index.html" },
    { "source": "/design-system", "destination": "/index.html" },
    { "source": "/painel", "destination": "/index.html" },
    { "source": "/painel/:path*", "destination": "/index.html" },
    { "source": "/planos", "destination": "/index.html" },
    { "source": "/planos/:path*", "destination": "/index.html" },
    { "source": "/lp", "destination": "/index.html" },
    { "source": "/lp/:path*", "destination": "/index.html" },
    { "source": "/cotacao", "destination": "/index.html" },
    { "source": "/operadoras", "destination": "/index.html" },
    { "source": "/como-funciona", "destination": "/index.html" },
    { "source": "/depoimentos", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/painel",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/painel/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/chat",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/design-system",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/forms/:slug",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/links",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/api-docs.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    }
  ]
}
